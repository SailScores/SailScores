@using SailScores.Api.Enumerations
@using SailScores.Core.Model
@using Microsoft.Extensions.Localization
@using SailScores.Web.Extensions
@using SailScores.Web.Resources
@using SailScores.Web.Services.Interfaces

@inject IStringLocalizer<SharedResource> localizer
@inject ICustomViewService customViewService

@model CompetitorExportViewModel

@{
    ViewBag.Title = 
        (Model.Competitors.Count == 1 ? 
        Model.Competitors.First().Key + " " : "") + "Competitor List - SailScores";
    Layout = null;

    // Resolve template settings for determining which custom fields to show
    var customFieldsToShow = customViewService.GetVisibleCustomFields(Model.Template);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>@ViewBag.Title</title>
    @await Html.EmbedCss($"css{System.IO.Path.DirectorySeparatorChar}site.min.css")
    @*<inline-style href="css/site.min.css" />*@
    <meta name="robots" content="noindex">
</head>
<body>
    <div class="body-content">
        <main class="col-12 col-lg-9 py-md-3 ps-md-5 bd-content" role="main">
            <div class="row">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr>
                            <th scope="col">@localizer["Sail Number"]</th>
                            <th scope="col">@localizer["Alt Sail Number"]</th>
                            <th scope="col">@localizer["Name"]</th>
                            <th scope="col">@localizer["Boat"]</th>
                            <th scope="col">@localizer["Club"]</th>
                            <th scope="col">@localizer["Class"]</th>
                            @foreach (var customField in customFieldsToShow)
                            {
                                if (Model.CustomFieldDefinitions.TryGetValue(customField.FieldDefinitionId, out var definition))
                                {
                                    <th scope="col">@customViewService.GetCustomFieldHeader(customField, definition)</th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var boatGroup in Model.Competitors)
                        {
                            @if (Model.Competitors.Count > 1)
                            {
                                <tr>
                                    <th colspan="@(6 + customFieldsToShow.Count)" class="text-center">@boatGroup.Key</th>
                                </tr>
                            }

                            @foreach (var comp in boatGroup.Value)
                            {
                                <tr>
                                    <td>@comp.SailNumber</td>
                                    <td>@comp.AlternativeSailNumber</td>
                                    <td>@comp.Name</td>
                                    <td>@comp.BoatName</td>
                                    <td>@comp.HomeClubName</td>
                                    <td>@comp.BoatClass?.Name</td>
                                    @foreach (var customField in customFieldsToShow)
                                    {
                                        <td>
                                            @{
                                                var fieldValue = customViewService.GetCustomFieldValue(comp, customField.FieldDefinitionId);
                                                @(fieldValue ?? "—")
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </main>
    </div>
</body>
</html>


