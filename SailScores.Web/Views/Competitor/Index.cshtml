@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Localization
@using SailScores.Core.Services
@using SailScores.Core.Utility
@using SailScores.Web.Models.SailScores;
@using SailScores.Web.Resources
@using SailScores.Web.Services

@inject IStringLocalizer<SharedResource> localizer
@inject AppSettingsService settingsService

@model ClubCollectionViewModel<CompetitorIndexViewModel>

@{
    ViewBag.Title = Model.ClubInitials + " " + localizer["Competitors"];
    Layout = "_ClubLayout";
}
<div class="container-lg px-0 px-sm-2">
    @if (Model.CanEdit)
    {
        @Html.AntiForgeryToken()
    }
    <div class="row align-items-center mb-3">
        <div class="col-12 col-lg-6">
            <h1>@localizer["Competitors"]</h1>
        </div>
        @if (Model.CanEdit)
        {
            <div class="col-12 col-lg-6">
                <div class="bg-almost border rounded p-3">
                    <div class="row g-2">
                        <div class="col-4 d-flex justify-content-center">
                            <a class="btn btn-primary" asp-action="CreateMultiple" asp-controller="Competitor">
                                Create
                            </a>
                        </div>
                        <div class="col-4 d-flex justify-content-center">
                            <div class="btn-group">
                                <button type="button" class="btn btn-warning dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Utilities
                                </button>
                                <div class="dropdown-menu">
                                  <a class="dropdown-item"
                                     asp-action="Manage"
                                     asp-controller="Fleet"
                                     asp-route-clubInitials="@Model.ClubInitials">
                                      Fleet Membership
                                  </a>
                                    <a class="dropdown-item" asp-action="Options" asp-controller="MergeCompetitor">
                                        Merge Two Competitors
                                    </a>
                                    <a class="dropdown-item" asp-action="ClearAltNumbers" asp-controller="Competitor">
                                        Clear Alt Sail Numbers
                                    </a>
                                    @* <div class="dropdown-divider"></div> *@
                                    <a class="dropdown-item" asp-action="InactivateMultiple" asp-controller="Competitor">
                                        Bulk Inactivate
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 d-flex justify-content-center">
                            <a class="btn btn-outline-primary" asp-action="Index" asp-controller="Admin">
                                Club Admin
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="row">
        <div class="col-6 col-sm-auto py-2">
            <div class="row">
                <label class="control-label col-form-label col-auto pe-0"
                       for="fleet-filter">Fleet </label>
                <div class="col">
                    <select id="fleet-filter"
                            class="form-select"
                            onchange="filterByFleet()">
                        <option value="">All</option>
                        @if (Model.FleetOptions != null)
                        {
                            foreach (var fleet in Model.FleetOptions)
                            {
                                @if (Model.SelectedFleetId == fleet.Id)
                                {
                                    <option value="@fleet.Id" selected>
                                        @fleet.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@fleet.Id">
                                        @fleet.Name
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
        @if (Model.CanEdit)
        {
            <div class="col-6 col-sm-auto py-2">
                <div class="form-check" style="padding-top: 0.375rem;">
                    <input type="checkbox" id="show-inactive" name="show-inactive"
                           class="form-check-input"
                           value="show-inactive"
                           checked
                           onchange="changeVisibility(300)">
                    <label for="show-inactive"
                           class="form-check-label"> Show inactive</label>
                </div>
            </div>
        }
        <div class="col-6 col-sm-auto py-2">
            <div class="row">
                <label class="control-label col-form-label col-auto pe-0"
                       for="sort-order">Sort </label>
                <div class="col">
                    <select id="sort-order"
                            class="form-select"
                            onchange="sortCompetitors()">
                        <option value="name">Name</option>
                        <option value="sail">Sail Number</option>
                        <option value="created">Creation Date (Descending)</option>
                        <option value="class">Class</option>
                        @* Append HighlyVisible field names as additional sort options *@
                        @if (Model.List != null && Model.List.Any())
                        {
                            var hvFields = Model.List.SelectMany(i => i.HighlyVisibleCustomFieldValues)
                                .Select(f => f.Label)
                                .Distinct()
                                .ToList();
                            foreach (var label in hvFields)
                            {
                                <option value="hv:@label">@label</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
        @if (Model.CanEdit)
        {
            <div class="col-6 col-sm-auto py-2 text-end">
                <button class="btn btn-outline-secondary btn-sm"
                onclick="exportCompetitors('html')"
                title="Export as HTML">
                    <span class="fas fa-2x fa-file-code"></span>
                </button>
                <button class="btn btn-outline-secondary btn-sm"
                onclick="exportCompetitors('csv')"
                title="Export as CSV">
                    <span class="fas fa-2x fa-file-csv"></span>
                </button>
            </div>
        }
    </div>
    <br />

    <div id="comp-list">
        @foreach (var item in Model.List)
        {
            <div class="row border-bottom mb-1 pb-1 comp-row @(item.IsActive ? "" : "comp-inactive") "
                 data-name="@item.Name"
                 data-sail="@item.SailNumber"
                 data-created="@item.Created?.ToString("o")"
                 data-class="@item.BoatClass?.Name">
                @if (Model.CanEdit)
                {
                    <div class="col-12 col-md-4 col-lg-3 pe-1">
                        @if (!item.IsDeletable)
                        {
                            <span data-bs-toggle="tooltip" title="Cannot be deleted: @item.PreventDeleteReason">
                            <button class="btn btn-sm btn-outline-danger me-2 mb-2 disabled"
                                    disabled="disabled"
                                type="button">
                                <span class="fas fa-trash"></span>
                            </button>
                            </span>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-danger me-2 mb-2"
                               asp-action="Delete"
                               asp-controller="Competitor"
                               asp-route-id="@item.Id"
                               title="Delete">
                                <span class="fas fa-trash"></span>
                            </a>
                        }
                        <a class="btn btn-sm btn-outline-primary me-2 mb-2"
                           asp-action="Edit"
                           asp-controller="Competitor"
                           asp-route-id="@item.Id"
                           title="Edit">
                            <span class="fas fa-pen"></span>
                        </a>
                        @if (Model.UseAlternativeSailNumbers)
                        {
                            <button type="button"
                                    class="btn btn-sm mb-2 btn-outline-secondary comp-alt-sail-btn"
                                    title="@(string.IsNullOrWhiteSpace(item.AlternativeSailNumber) ? "Set Alternative Sail Number" : "Change Alternative Sail Number")"
                                    data-competitor-id="@item.Id"
                                    data-competitor-name="@item.Name"
                                    data-sail-number="@item.SailNumber"
                                    data-alt-sail-number="@item.AlternativeSailNumber">
                                @if (string.IsNullOrWhiteSpace(item.AlternativeSailNumber))
                                {
                                    <span class="fas fa-hashtag"></span>
                                }
                                else
                                {
                                    <span class="fas fa-hashtag"></span>
                                    <span class="ms-1"><strong>@item.AlternativeSailNumber</strong></span>
                                }
                            </button>
                        }
                    </div>
                }
                <div class="col-12 col-md-8 col-lg-9">
                    <div class="row">
                        <div class="col-3">
                            <a asp-route="Competitor"
                               asp-route-clubInitials="@Model.ClubInitials"
                               asp-route-urlName="@UrlUtility.GetUrlName(item.UrlName)">
                                <strong>@Html.DisplayFor(modelItem => item.SailNumber)</strong>
                            </a>
                        </div>
                        <div class="col-8 col-md-3">
                            @Html.DisplayFor(modelItem => item.Name)
                        </div>
                        <div class="col-12 col-md-6">
                            <small>@Html.DisplayFor(modelItem => item.BoatClass.Name)</small>
                            <em>@Html.DisplayFor(modelItem => item.BoatName)</em>

                            @if(Model.CanEdit) {
                            <div class="form-check form-check-inline float-end">
                                <input class="form-check-input comp-active-switch" type="checkbox"
                                        id="comp-active-@item.Id"
                                        @(item.IsActive ? "checked" : "")
                                        data-ss-competitorid="@item.Id">
                                <label class="form-check-label" for="comp-active-@item.Id"><em>Active</em></label>
                            </div>
                            } else
                            {
                            <em class="text-warning small float-end">@(item.IsActive ? "" : "Inactive")</em>
                            }

                        </div>

                        <div class="d-none d-md-block col-md-12 col-lg-9 ">
                            @Html.DisplayFor(modelItem => item.Notes)
                        </div>

                        <div class="col-12 mt-1">
                            <div class="row g-1">
                                <div class="col-12 col-lg-9">
                                    @if (item.HighlyVisibleCustomFieldValues != null
                                        && item.HighlyVisibleCustomFieldValues.Any())
                                    {
                                        <div class="row g-1">
                                            @foreach (var fieldValue in item.HighlyVisibleCustomFieldValues)
                                            {
                                                <div class="col-6 col-lg-4 hv-field"
                                                     data-hv-label="@fieldValue.Label"
                                                     data-hv-value="@fieldValue.Value">
                                                    <small class="text-muted">@fieldValue.Label</small>
                                                    <span class="ms-1">@fieldValue.Value</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="col-12 col-lg-3 text-lg-end">
                                    <span class="small text-muted">
                                    @if (item.Created.HasValue)
                                    {
                                        @localizer["created"]
                                        @Html.Raw(" ")
                                        @item.Created.Value.ToString("d")
                                    }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.CanEdit && Model.UseAlternativeSailNumbers)
{
    @await Html.PartialAsync("_editAltSailNumberModal")
}

@section Scripts {
    <script>
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

        function setCookie(name, value, days) {
            const d = new Date();
            d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
            const expires = "expires=" + d.toUTCString();
            document.cookie = name + "=" + value + ";" + expires + ";path=/";
        }

        function getCookie(name) {
            const cname = name + "=";
            const decodedCookie = decodeURIComponent(document.cookie);
            const ca = decodedCookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(cname) == 0) {
                    return c.substring(cname.length, c.length);
                }
            }
            return "";
        }

        function sortCompetitors() {
            const selectedSort = ($('#sort-order').val() || 'name').toLowerCase();
            setCookie('competitorSortOrder', selectedSort, 30); // Store the sort order in a cookie for 30 days
            const result = $('.comp-row').sort(function (a, b) {
                return compareCompetitors(a, b, selectedSort);
            });
            $('#comp-list').empty();
            $('#comp-list').append(result);
        }

        function compareCompetitors(a, b, selectedSort) {
            const primaryComparison = comparePrimarySortValue(a, b, selectedSort);
            if (primaryComparison !== 0) {
                return primaryComparison;
            }

            const sailComparison = alphanumericCompare(
                normalizeSortValue($(a).data('sail')),
                normalizeSortValue($(b).data('sail'))
            );
            if (sailComparison !== 0) {
                return sailComparison;
            }

            return alphanumericCompare(
                normalizeSortValue($(a).data('name')),
                normalizeSortValue($(b).data('name'))
            );
        }

        function comparePrimarySortValue(a, b, selectedSort) {
            if (selectedSort === 'created') {
                const createdA = parseCreatedDate($(a).data('created'));
                const createdB = parseCreatedDate($(b).data('created'));

                if (createdA === null && createdB === null) {
                    return 0;
                }
                if (createdA === null) {
                    return 1;
                }
                if (createdB === null) {
                    return -1;
                }

                return createdB - createdA;
            }

            if (selectedSort === 'class') {
                return alphanumericCompare(
                    normalizeSortValue($(a).data('class')),
                    normalizeSortValue($(b).data('class'))
                );
            }

            if (selectedSort === 'sail') {
                return alphanumericCompare(
                    normalizeSortValue($(a).data('sail')),
                    normalizeSortValue($(b).data('sail'))
                );
            }

            // Support sorting by highly visible field: option value will be 'hv:Field Label'
            if (selectedSort && selectedSort.startsWith('hv:')) {
                const label = selectedSort.substring(3).trim().toLocaleLowerCase();

                function findFieldValue(container) {
                    let found = '';
                    container.find('.hv-field').each(function () {
                        const currentLabel = (this.dataset.hvLabel || '').trim().toLocaleLowerCase();
                        if (currentLabel === label) {
                            found = (this.dataset.hvValue || '').trim();
                            return false;
                        }
                    });

                    return normalizeSortValue(found);
                }

                const aVal = findFieldValue($(a));
                const bVal = findFieldValue($(b));
                return alphanumericCompare(aVal, bVal);
            }

            return alphanumericCompare(
                normalizeSortValue($(a).data('name')),
                normalizeSortValue($(b).data('name'))
            );
        }

        function parseCreatedDate(value) {
            if (!value) {
                return null;
            }

            const parsed = Date.parse(value);
            return Number.isNaN(parsed) ? null : parsed;
        }

        function normalizeSortValue(value) {
            return value == null ? '' : '' + value;
        }

        function alphanumericCompare(x, y) {
            // if the first word is numeric on both, compare as numbers
            if (x && y && x.length > 0 && y.length > 0) {
                const xWord = x.trim().split(' ')[0];
                const yWord = y.trim().split(' ')[0];
                if (xWord.length > 0 && yWord.length > 0 && /^\d+$/.test(xWord) && /^\d+$/.test(yWord)) {
                    return parseInt(xWord, 10) - parseInt(yWord, 10);
                }

                const firstWordComparison = xWord.localeCompare(yWord);
                if (firstWordComparison !== 0 || !xWord.trim() || !yWord.trim()) {
                    return firstWordComparison;
                }
                return alphanumericCompare(x.substring(xWord.length), y.substring(yWord.length));
            }
            return x.localeCompare(y);
        }



        function changeVisibility(speed) {
            if (speed == null) {
                speed = 300;
            }

            if ($('#show-inactive').is(":checked")) {
                $('.comp-row').show(speed);
                setCookie('showInactiveComps', true, 30);
            } else {
                $('.comp-inactive').hide(speed);
                setCookie('showInactiveComps', false, 30);
            }
        }

        function filterByFleet() {
            const fleetId = $('#fleet-filter').val();
            const showInactive = $('#show-inactive').is(":checked");
            const clubInitials = '@Model.ClubInitials';
            
            let url = `/${clubInitials}/Competitor`;
            if (fleetId) {
                url += `?fleetId=${fleetId}`;
            }
            
            window.location.href = url;
        }

        function exportCompetitors(format) {
            const clubInitials = '@Model.ClubInitials';
            const fleetId = $('#fleet-filter').val();
            const includeInactive = $('#show-inactive').is(":checked");
            
            let url = `/${clubInitials}/Competitor/Export${format === 'html' ? 'Html' : 'Csv'}`;
            const params = new URLSearchParams();
            
            if (fleetId) {
                params.append('fleetId', fleetId);
            }
            params.append('includeInactive', includeInactive);
            
            if (params.toString()) {
                url += `?${params.toString()}`;
            }
            
            window.location.href = url;
        }



        function callAjaxCompActivate(
                competitorId,
                active,
                domElement) {
                var token = $('input[name="__RequestVerificationToken"]').val();
        
                let ajaxUrl = 'competitor/SetCompActive'; // Default relative URL
                const currentPath = window.location.pathname.toLowerCase(); // Convert to lowercase for case-insensitive comparison

                if (currentPath.endsWith("competitor/")) {
                    ajaxUrl = 'SetCompActive'; // Adjust the URL for "competitor/"
                }

                $.ajax({
                    type: 'POST',
                    url: ajaxUrl,
                    data: { CompetitorId: competitorId, Active: active },
                    headers: {
                        'RequestVerificationToken': token
                    },
                    dataType: "json"
                }).done(function (data) {
                    updateActiveUi(competitorId, active, domElement);
                }).fail(function () {
                    $(domElement).prop('checked', !active);
                });
        }

        function updateActiveUi(
            competitorId,
            active,
            domElement) {
                var ancestor = $(domElement).closest(".comp-row")
                if (active) {
                    ancestor.removeClass('comp-inactive');
                } else {
                    ancestor.addClass('comp-inactive');
                }

                if($('#show-inactive').is(":checked") ) {
                    $('.comp-row').show(300);
                } else {
                    $('.comp-inactive').hide(300);
                }
            }

        function initializeToggles() {
            $('.comp-active-switch').on('change', function() {
                let activate = $(this).is(':checked');
                let compId = $(this).data('ss-competitorid');

                callAjaxCompActivate(
                    compId,
                    activate,
                    this
                );

            });
        }

        $(document).ready(function () {
            const savedSortOrder = getCookie('competitorSortOrder');
            const showInactiveCompsString = getCookie('showInactiveComps');
            const showInactiveComps = (showInactiveCompsString === 'true');

            if (savedSortOrder) {
                $('#sort-order').val(savedSortOrder);
            }
            if (!showInactiveComps) {
                $('#show-inactive').prop('checked', false);
            } else {
                    console.log("set checkbox true");
                $('#show-inactive').prop('checked', true);
            }
            sortCompetitors();
            changeVisibility(0);
            initializeToggles();
            initializeAltSailButtons();
        });

        function initializeAltSailButtons() {
            const setAlternativeSailNumberUrl = '@Url.Action("SetAlternativeSailNumber", "Competitor", new { clubInitials = Model.ClubInitials })';
            const conflictResolutionStorageKey = 'altSailConflictResolution';

            document.querySelectorAll('.comp-alt-sail-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const competitorId = this.dataset.competitorId;
                    const competitorName = this.dataset.competitorName;
                    const sailNumber = this.dataset.sailNumber;
                    const altSailNumber = this.dataset.altSailNumber || '';

                    document.getElementById('altSailNumberCompetitorId').value = competitorId;
                    document.getElementById('altSailNumberCompetitorName').textContent = competitorName;
                    document.getElementById('altSailNumberSailNumber').textContent = sailNumber;
                    document.getElementById('altSailNumberInput').value = altSailNumber;

                    const savedConflictResolution = localStorage.getItem(conflictResolutionStorageKey);
                    const conflictRadioToSelect = document.querySelector(
                        'input[name="altSailNumberConflictResolution"][value="' + savedConflictResolution + '"]');
                    if (conflictRadioToSelect) {
                        conflictRadioToSelect.checked = true;
                    } else {
                        document.getElementById('conflictAllowDuplicates').checked = true;
                    }

                    const modalElement = document.getElementById('editAltSailNumberModal');
                    const modal = new bootstrap.Modal(modalElement);

                    modalElement.addEventListener('shown.bs.modal', function onModalShown() {
                        const altInput = document.getElementById('altSailNumberInput');
                        if (altInput) {
                            altInput.focus();
                            altInput.select();
                        }
                        modalElement.removeEventListener('shown.bs.modal', onModalShown);
                    }, { once: true });

                    modal.show();
                });
            });

            const saveBtn = document.getElementById('altSailNumberSaveButton');
            if (saveBtn) {
                saveBtn.addEventListener('click', function () {
                    const competitorId = document.getElementById('altSailNumberCompetitorId').value;
                    const altSailNumber = document.getElementById('altSailNumberInput').value;
                    const conflictResolution = document.querySelector('input[name="altSailNumberConflictResolution"]:checked').value;
                    localStorage.setItem(conflictResolutionStorageKey, conflictResolution);
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    fetch(setAlternativeSailNumberUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: new URLSearchParams({
                            CompetitorId: competitorId,
                            AlternativeSailNumber: altSailNumber,
                            ConflictResolution: conflictResolution
                        })
                    })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Save failed');
                        return response.json();
                    })
                    .then(function (data) {
                        // Update the button's stored data and appearance
                        const btn = document.querySelector('.comp-alt-sail-btn[data-competitor-id="' + data.competitorId + '"]');
                        if (btn) {
                            btn.dataset.altSailNumber = data.alternativeSailNumber || '';
                            if (data.alternativeSailNumber) {
                                btn.classList.remove('btn-outline-secondary');
                                btn.classList.add('btn-outline-dark');
                                btn.innerHTML = '<span class="fas fa-hashtag"></span><span class="small ms-1">' + data.alternativeSailNumber + '</span>';
                                btn.title = 'Change Alternative Sail Number';
                            } else {
                                btn.classList.remove('btn-outline-dark');
                                btn.classList.add('btn-outline-secondary');
                                btn.innerHTML = '<span class="fas fa-hashtag"></span>';
                                btn.title = 'Set Alternative Sail Number';
                            }
                        }
                        // If conflict resolution cleared others, refresh the page to reflect changes
                        if (parseInt(conflictResolution) > 0) {
                            window.location.reload();
                        } else {
                            bootstrap.Modal.getInstance(document.getElementById('editAltSailNumberModal')).hide();
                        }
                    })
                    .catch(function () {
                        alert('Failed to save alternative sail number. Please try again.');
                    });
                });
            }
        }
    </script>
}
