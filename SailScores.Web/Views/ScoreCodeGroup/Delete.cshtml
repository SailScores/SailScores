@model SailScores.Core.Model.ScoreCodeGroup

@{
    ViewData["Title"] = "Delete Score Code Group";
    Layout = "~/Views/Shared/_ClubLayout.cshtml";
}

<h4>Delete Score Code Group</h4>
<hr />

<p class="alert alert-warning">
    <strong>Are you sure you want to delete this score code group?</strong>
</p>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Name) ? Model.DisplayName : Model.Name)</dd>

            <dt class="col-sm-3">Codes</dt>
            <dd class="col-sm-9">
                @if (Model.IncludedCodeNames?.Count > 0)
                {
                    <span>@string.Join(", ", Model.IncludedCodeNames.OrderBy(c => c))</span>
                }
                else
                {
                    <span class="text-muted">(No codes)</span>
                }
            </dd>

            <dt class="col-sm-3">Limitation</dt>
             <dd class="col-sm-9">
                @switch (Model.LimitationType)
                {
                    case SailScores.Core.Model.ScoreCodeGroupLimitationType.NumberOfRaces:
                        <span>Maximum @Model.LimitationValue.ToString("0.###") races</span>
                        break;
                    case SailScores.Core.Model.ScoreCodeGroupLimitationType.PercentOfRaces:
                        <span>Maximum @Model.LimitationValue.ToString("0.###")% of @(Model.UseNonDiscardedRaces ? "non-discarded" : "all") races</span>
                        break;
                    case SailScores.Core.Model.ScoreCodeGroupLimitationType.NumberOfDates:
                        <span>Maximum @Model.LimitationValue.ToString("0.###") dates</span>
                        break;
                }
            </dd>

            <dt class="col-sm-3">Overage Code</dt>
            <dd class="col-sm-9">@Model.OverageCodeName</dd>

            <dt class="col-sm-3">Overage Selection</dt>
            <dd class="col-sm-9">
                @(Model.OverageSelectionMethod == SailScores.Core.Model.ScoreCodeGroupOverageSelection.LatestFirst ? "Latest First (Preserve Earliest)" : "Worst First")
            </dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ScoringSystemId" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="@ViewBag.ReturnUrl" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
