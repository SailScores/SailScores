@using SailScores.Api.Enumerations
@using SailScores.Core.Utility
@model SailScores.Web.Models.SailScores.SeriesResultsTemplateListViewModel
@{
    ViewData["Title"] = "Results Display";
    Layout = "_ClubLayout";
}

@functions {
    // The competitor columns a view shows, by their header; hidden columns are left out.
    private static IEnumerable<(string Text, bool LargerScreensOnly)> ShownColumns(SailScores.Core.Model.SeriesResultsTemplate template)
    {
        var columns = new[]
        {
            (template.SailNumberVisibility, template.SailNumberHeader, "Sail Number"),
            (template.AlternativeSailNumberVisibility, template.AlternativeSailNumberHeader, "Alt. Sail Number"),
            (template.CompetitorNameVisibility, template.CompetitorNameHeader, "Competitor Name"),
            (template.BoatNameVisibility, template.BoatNameHeader, "Boat Name"),
            (template.CompetitorClubVisibility, template.CompetitorClubHeader, "Club"),
        };
        return columns
            .Where(c => c.Item1 != ColumnVisibility.Hidden)
            .Select(c => (string.IsNullOrWhiteSpace(c.Item2) ? c.Item3 : c.Item2,
                c.Item1 == ColumnVisibility.OnLargerScreens));
    }

    // A few words for each other setting that differs from a new view's.
    private static IEnumerable<string> OtherSettings(SailScores.Core.Model.SeriesResultsTemplate template)
    {
        if (template.RaceColumnsVisibility == ColumnVisibility.Hidden)
        {
            yield return "Race columns hidden";
        }
        else if (template.RaceColumnsVisibility == ColumnVisibility.OnLargerScreens)
        {
            yield return "Race columns on larger screens";
        }
        if (template.PreDiscardTotalVisibility != ColumnVisibility.Hidden)
        {
            yield return "Pre-discard total shown";
        }
        if (template.ParticipationVisibility != ColumnVisibility.Hidden)
        {
            yield return "Participation shown";
        }
        var customFieldCount = template.CustomFields.Count(f => f.Visibility != ColumnVisibility.Hidden);
        if (customFieldCount > 0)
        {
            yield return customFieldCount == 1 ? "1 custom field shown" : $"{customFieldCount} custom fields shown";
        }
        if (template.ScoreCodes.Any(c => c.Display is ScoreCodeDisplay.Hidden or ScoreCodeDisplay.HiddenWhenDiscarded))
        {
            yield return "Some scores hidden";
        }
        if (template.ScoreCodes.Any(c => c.Display == ScoreCodeDisplay.CodeOnly || c.Faded))
        {
            yield return "Some codes restyled";
        }
        if (!template.ShowWeather)
        {
            yield return "No weather";
        }
        if (template.ShowClubLogo)
        {
            yield return "Club logo";
        }
    }
}

<div class="container-lg p-0 p-md-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <div>
            <h1 class="h2 mb-1">@ViewData["Title"]</h1>
            <p class="text-body-secondary mb-0">
                Change the result views: columns, headers,
                and displayed codes.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Admin" asp-action="Edit" asp-route-clubInitials="@Model.ClubInitials" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Back to Settings
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    @if (Model.Templates.Any())
    {
        <div class="border rounded p-2 p-md-3 mb-4 bg-almost">
            <h2 class="h5 mb-3">Default views</h2>
            <form asp-action="SetDefaults" asp-route-clubInitials="@Model.ClubInitials" method="post">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DefaultSeriesResultsTemplateId" class="form-label"></label>
                        <select asp-for="DefaultSeriesResultsTemplateId" class="form-select">
                            <option value="">(none)</option>
                            @foreach (var template in Model.Templates)
                            {
                                <option value="@template.Id">@template.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DefaultSummarySeriesResultsTemplateId" class="form-label"></label>
                        <select asp-for="DefaultSummarySeriesResultsTemplateId" class="form-select">
                            <option value="">Same as standard</option>
                            @foreach (var template in Model.Templates)
                            {
                                <option value="@template.Id">@template.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DefaultRegattaSeriesResultsTemplateId" class="form-label"></label>
                        <select asp-for="DefaultRegattaSeriesResultsTemplateId" class="form-select">
                            <option value="">(none)</option>
                            @foreach (var template in Model.Templates)
                            {
                                <option value="@template.Id">@template.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Save defaults</button>
            </form>
        </div>
    }

    <div class="border rounded p-2 p-md-3 mb-4 bg-almost">
        <h2 class="h5 mb-3">Race dates</h2>
        <form asp-action="SetDateFormat" asp-route-clubInitials="@Model.ClubInitials" method="post">
            <div class="mb-3">
                <label asp-for="DefaultDateFormat" class="form-label"></label>
                <div class="input-group" style="max-width: 30rem;">
                    <input asp-for="DefaultDateFormat" class="form-control" placeholder="MM/dd" autocomplete="off" />
                    <button type="button" class="btn btn-outline-secondary" id="clearDateFormatButton">Use locale default</button>
                </div>
                <div class="small text-body-secondary mt-1">
                    Dates in result headers. Leave blank to use the
                    club's localization. Supported tokens: d, dd, M, MM, MMM, MMMM, yy, yyyy. For example,
                    'M' uses a single-digit month when possible, while 'MM' always uses two digits, and
                    'MMM' uses the name abbreviation. Popular formats:
                    <code>M/d</code>, <code>dd.MM</code>, or <code>d MMM</code>.
                </div>
                @{
                    string datePreview = "Uses localization default.";
                    if (ClubDateFormatUtility.TryNormalize(Model.DefaultDateFormat, out var normalizedFormat, out _)
                        && !string.IsNullOrWhiteSpace(normalizedFormat))
                    {
                        datePreview = $"Example: {DateTime.Today.ToString(normalizedFormat)}";
                    }
                }
                <div class="small text-body-secondary mt-1" id="dateFormatPreview">@datePreview</div>
            </div>
            <button type="submit" class="btn btn-primary">Save date format</button>
        </form>
    </div>

    <h2 class="h5 mb-3">Views</h2>
    <div class="mb-2">
        <a asp-action="Create" asp-route-clubInitials="@Model.ClubInitials" class="btn btn-primary">
            <span class="fas fa-plus"></span>
            New Results View
        </a>
    </div>

    @if (!Model.Templates.Any())
    {
        <div class="border rounded p-3 bg-almost">
            <p class="mb-0 text-body-secondary">
                No results views have been created yet. Create one to define the results layout.
            </p>
        </div>
    }
    else
    {
        <div class="overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-body-tertiary">
                        <tr>
                            <th class="text-body-emphasis">Name</th>
                            <th class="text-end text-body-emphasis">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model.Templates)
                        {
                            var shownColumns = ShownColumns(template).ToList();
                            var otherSettings = OtherSettings(template).ToList();
                            <tr>
                                <td>
                                    <div>
                                        <strong>@template.Name</strong>
                                        @if (template.Id == Model.DefaultSeriesResultsTemplateId)
                                        {
                                            <span class="badge text-bg-primary ms-1">Standard default</span>
                                        }
                                        @if (template.Id == Model.DefaultSummarySeriesResultsTemplateId)
                                        {
                                            <span class="badge text-bg-primary ms-1">Summary default</span>
                                        }
                                        @if (template.Id == Model.DefaultRegattaSeriesResultsTemplateId)
                                        {
                                            <span class="badge text-bg-primary ms-1">Regatta default</span>
                                        }
                                    </div>
                                    <small class="text-body-secondary">
                                        @if (shownColumns.Any())
                                        {
                                            for (var i = 0; i < shownColumns.Count; i++)
                                            {
                                                @(i > 0 ? " · " : "")
                                                @shownColumns[i].Text
                                                @if (shownColumns[i].LargerScreensOnly)
                                                {
                                                    <i class="fas fa-desktop ms-1" title="Larger screens only"></i>
                                                    <span class="visually-hidden">(larger screens only)</span>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            @:No competitor columns
                                        }
                                    </small>
                                    @if (otherSettings.Any())
                                    {
                                        <small class="text-body-secondary d-block fst-italic">@string.Join(" · ", otherSettings)</small>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-clubInitials="@Model.ClubInitials" asp-route-id="@template.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="fas fa-pen"></i>
                                        <span class="visually-hidden">Edit</span>
                                    </a>
                                    @if (Model.IsClubDefault(template.Id))
                                    {
                                        <span class="d-inline-block" tabindex="0" title="A club default can't be deleted">
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled>
                                                <i class="fas fa-trash"></i>
                                                <span class="visually-hidden">Delete</span>
                                            </button>
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-action="Delete" asp-route-clubInitials="@Model.ClubInitials" asp-route-id="@template.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                            <span class="visually-hidden">Delete</span>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('DefaultDateFormat');
            var clearButton = document.getElementById('clearDateFormatButton');
            var preview = document.getElementById('dateFormatPreview');
            var sampleDate = new Date();

            function formatSampleDate(pattern) {
                if (!pattern || !pattern.trim()) {
                    return 'Uses localization default.';
                }

                var month = sampleDate.getMonth() + 1;
                var day = sampleDate.getDate();
                var year = sampleDate.getFullYear();

                var shortMonthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                var longMonthNames = [
                    'January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'
                ];

                // One pass, so a month name (May, March) isn't read again as tokens.
                var tokens = {
                    yyyy: String(year),
                    yy: String(year).slice(-2),
                    MMMM: longMonthNames[month - 1],
                    MMM: shortMonthNames[month - 1],
                    MM: String(month).padStart(2, '0'),
                    M: String(month),
                    dd: String(day).padStart(2, '0'),
                    d: String(day)
                };
                var output = pattern.replace(/yyyy|yy|MMMM|MMM|MM|M|dd|d/g, function (token) {
                    return tokens[token];
                });

                return 'Example: ' + output;
            }

            function updatePreview() {
                preview.textContent = formatSampleDate(input.value);
            }

            clearButton.addEventListener('click', function () {
                input.value = '';
                updatePreview();
            });

            input.addEventListener('input', updatePreview);
        })();
    </script>
}
