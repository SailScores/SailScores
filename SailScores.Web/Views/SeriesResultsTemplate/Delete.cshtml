@model SailScores.Web.Models.SailScores.SeriesResultsTemplateViewModel
@{
    ViewData["Title"] = "Delete Results Display Template";
    Layout = "_ClubLayout";
}

<div class="container-lg p-0 p-md-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2 mb-3">
        <div>
            <h1 class="h2 mb-1">@ViewData["Title"]</h1>
            <p class="text-body-secondary mb-0">Delete this template and remove its configuration.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (!Model.IsClubDefault)
            {
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </form>
            }
            <a asp-action="Index" asp-route-clubInitials="@Model.ClubInitials" class="btn btn-outline-primary">
                Back
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.IsClubDefault)
    {
        <div class="alert alert-warning mb-3">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Warning:</strong> This template is currently set as a club default. You must change the club default settings before deleting this template.
            <a asp-controller="Admin" asp-action="Edit" asp-route-clubInitials="@Model.ClubInitials" class="alert-link">
                Go to Club Settings
            </a>
        </div>
    }

    <div class="border rounded p-3 p-md-4 bg-almost">
        <p class="mb-3">Are you sure you want to delete this template?</p>

        <dl class="row mb-0">
            <dt class="col-sm-3">Template Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Sail Number</dt>
            <dd class="col-sm-9">
                @switch (Model.SailNumberVisibility)
                {
                    case SailScores.Api.Enumerations.ColumnVisibility.Always:
                        <span class="badge text-bg-success">Always</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.OnLargerScreens:
                        <span class="badge text-bg-info">On Larger Screens</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.Hidden:
                        <span class="badge text-bg-secondary">Hidden</span>
                        break;
                }
            </dd>

            <dt class="col-sm-3">@Model.CompetitorNameHeader</dt>
            <dd class="col-sm-9">
                @switch (Model.CompetitorNameVisibility)
                {
                    case SailScores.Api.Enumerations.ColumnVisibility.Always:
                        <span class="badge text-bg-success">Always</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.OnLargerScreens:
                        <span class="badge text-bg-info">On Larger Screens</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.Hidden:
                        <span class="badge text-bg-secondary">Hidden</span>
                        break;
                }
            </dd>

            <dt class="col-sm-3">@Model.BoatNameHeader</dt>
            <dd class="col-sm-9">
                @switch (Model.BoatNameVisibility)
                {
                    case SailScores.Api.Enumerations.ColumnVisibility.Always:
                        <span class="badge text-bg-success">Always</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.OnLargerScreens:
                        <span class="badge text-bg-info">On Larger Screens</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.Hidden:
                        <span class="badge text-bg-secondary">Hidden</span>
                        break;
                }
            </dd>

            <dt class="col-sm-3">Competitor Club</dt>
            <dd class="col-sm-9">
                @switch (Model.CompetitorClubVisibility)
                {
                    case SailScores.Api.Enumerations.ColumnVisibility.Always:
                        <span class="badge text-bg-success">Always</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.OnLargerScreens:
                        <span class="badge text-bg-info">On Larger Screens</span>
                        break;
                    case SailScores.Api.Enumerations.ColumnVisibility.Hidden:
                        <span class="badge text-bg-secondary">Hidden</span>
                        break;
                }
            </dd>
        </dl>

        @if (!Model.IsClubDefault)
        {
            <div class="alert alert-warning mt-3 mb-0">
                <i class="fas fa-info-circle"></i>
                <strong>Note:</strong> Any series currently using this template will revert to the club default template after deletion.
            </div>
        }
    </div>
</div>
