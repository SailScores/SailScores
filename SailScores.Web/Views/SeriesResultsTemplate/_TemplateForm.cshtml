@using SailScores.Api.Enumerations
@model SailScores.Web.Models.SailScores.SeriesResultsTemplateViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="border rounded p-3 p-md-4 mb-4 bg-almost">
    <h2 class="h5 mb-3">Template settings</h2>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="e.g., Standard, Mobile-Friendly, Regatta Full" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <small class="form-text text-body-secondary">Give this template a descriptive name to help identify its purpose.</small>
    </div>

    <div class="form-check">
        <input asp-for="ShowClubLogo" class="form-check-input" />
        <label asp-for="ShowClubLogo" class="form-check-label"></label>
        <small class="form-text text-body-secondary d-block">Displays the club logo in the upper right of the results page, browser prints, and HTML exports.</small>
    </div>
</div>

<div class="border rounded p-3 p-md-4 mb-4 bg-almost">
    <h2 class="h5 mb-3">Column visibility</h2>
    <p class="text-body-secondary small mb-3">
        Choose when each column should be displayed:
        <strong>Always</strong> = visible on all devices,
        <strong>On Larger Screens</strong> = hidden on phones but visible on tablets/desktops,
        <strong>Hidden</strong> = never shown.
    </p>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="SailNumberVisibility" class="form-label"></label>
            <select asp-for="SailNumberVisibility" asp-items="Html.GetEnumSelectList<ColumnVisibility>()" class="form-select"></select>
            <span asp-validation-for="SailNumberVisibility" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="CompetitorNameVisibility" class="form-label"></label>
            <select asp-for="CompetitorNameVisibility" asp-items="Html.GetEnumSelectList<ColumnVisibility>()" class="form-select"></select>
            <span asp-validation-for="CompetitorNameVisibility" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="BoatNameVisibility" class="form-label"></label>
            <select asp-for="BoatNameVisibility" asp-items="Html.GetEnumSelectList<ColumnVisibility>()" class="form-select"></select>
            <span asp-validation-for="BoatNameVisibility" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="CompetitorClubVisibility" class="form-label"></label>
            <select asp-for="CompetitorClubVisibility" asp-items="Html.GetEnumSelectList<ColumnVisibility>()" class="form-select"></select>
            <span asp-validation-for="CompetitorClubVisibility" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="RaceColumnsVisibility" class="form-label"></label>
            <select asp-for="RaceColumnsVisibility" asp-items="Html.GetEnumSelectList<ColumnVisibility>()" class="form-select"></select>
            <small class="form-text text-body-secondary">
                The columns for each race, or each child series in a summary series. When hidden, only the
                competitor columns and totals are shown.
            </small>
        </div>
    </div>
</div>

<div class="border rounded p-3 p-md-4 mb-4 bg-almost">
    <h2 class="h5 mb-3">Column headers</h2>
    <p class="text-body-secondary small mb-3">
        Customize the text shown in column headers. Common examples: "Helm", "Skipper", "Crew", "Name" for competitors;
        "Boat", "Yacht", "Dinghy" for boat names.
    </p>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CompetitorNameHeader" class="form-label"></label>
            <input asp-for="CompetitorNameHeader" class="form-control" placeholder="Helm" />
            <span asp-validation-for="CompetitorNameHeader" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="BoatNameHeader" class="form-label"></label>
            <input asp-for="BoatNameHeader" class="form-control" placeholder="Boat" />
            <span asp-validation-for="BoatNameHeader" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="border rounded p-3 p-md-4 mb-4 bg-almost">
    <h2 class="h5 mb-3">Score display options</h2>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" asp-for="HighlightTopThree" />
        <label class="form-check-label" asp-for="HighlightTopThree"></label>
        <small class="d-block form-text text-body-secondary">
            Colors first, second and third place finishes gold, silver and bronze.
        </small>
    </div>

    <div class="mb-3">
        <label asp-for="ColumnSeparators" class="form-label"></label>
        <select asp-for="ColumnSeparators" asp-items="Html.GetEnumSelectList<ResultsColumnSeparator>()" class="form-select"></select>
        <small class="form-text text-body-secondary">
            Draws vertical lines between race columns. In a summary series each child series is one column.
        </small>
    </div>

    <div class="form-check">
        <input class="form-check-input" type="checkbox" asp-for="ShowPreDiscardTotal" />
        <label class="form-check-label" asp-for="ShowPreDiscardTotal">
            Show Pre-Discard Total Column
        </label>
        <small class="d-block form-text text-body-secondary">
            When enabled, results include the "Pre-Discard Total" showing each competitor's total score
            before applying discards. This option is only displayed for low-point scoring
            systems, not for percentage-based systems.
        </small>
    </div>
</div>

<div class="border rounded p-3 p-md-4 mb-4 bg-almost">
    <h2 class="h5 mb-3">Custom competitor fields</h2>
    <p class="text-body-secondary small mb-3">
        Select which custom competitor fields should appear in this results view.
    </p>
    @if (Model.AvailableCustomFields != null && Model.AvailableCustomFields.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Include</th>
                        <th scope="col">Field</th>
                        <th scope="col">Visibility</th>
                        <th scope="col">Order</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Model.CustomFieldSelections.Count; index++)
                    {
                        var selection = Model.CustomFieldSelections[index];
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input" asp-for="@Model.CustomFieldSelections[index].Selected" />
                                <input type="hidden" asp-for="@Model.CustomFieldSelections[index].FieldDefinitionId" />
                                <input type="hidden" asp-for="@Model.CustomFieldSelections[index].Name" />
                                <input type="hidden" asp-for="@Model.CustomFieldSelections[index].DisplayHeader" />
                                <input type="hidden" asp-for="@Model.CustomFieldSelections[index].DataType" />
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(selection.DisplayHeader) ? selection.Name : selection.DisplayHeader)</td>
                            <td>
                                <select class="form-select form-select-sm" asp-for="@Model.CustomFieldSelections[index].Visibility" asp-items="Html.GetEnumSelectList<ColumnVisibility>()"></select>
                            </td>
                            <td>
                                <input class="form-control form-control-sm" asp-for="@Model.CustomFieldSelections[index].DisplayOrder" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-body-secondary mb-0">No custom competitor fields are available for this club yet.</p>
    }
</div>
