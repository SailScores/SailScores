@model SailScores.Web.Models.SailScores.SeriesResultsTemplateViewModel
@{
    ViewData["Title"] = "Edit Results View";
    Layout = "_ClubLayout";
}

<div class="container-lg p-0 p-md-2">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2 mb-3">
        <div>
            <h1 class="h2 mb-1">@ViewData["Title"]</h1>
            <p class="text-body-secondary mb-0">
                Change how series results are displayed for series that use this view.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary text-nowrap" data-bs-toggle="offcanvas"
                    data-bs-target="#resultsViewPreview" aria-controls="resultsViewPreview">
                <span class="fas fa-eye"></span>
                Preview
            </button>
            @if (!Model.IsReset)
            {
                <a asp-action="Edit" asp-route-clubInitials="@Model.ClubInitials" asp-route-id="@Model.Id"
                   asp-route-reset="true" class="btn btn-outline-secondary text-nowrap" data-keeps-preview
                   title="Fill in the default settings. Nothing changes until you save.">
                    <span class="fas fa-undo"></span>
                    Reset to defaults
                </a>
            }
        </div>
    </div>

    @if (Model.IsReset)
    {
        <div class="alert alert-info" role="alert" id="resetNotice">
            Form has been reset to SailScores defaults: a clean view with sail number, competitor and boat
            name, gold/silver/bronze places, faded and struck-through discards, all score codes shown
            with points, and no custom fields or vertical rules. Changes are not saved yet: use the Save
            button to apply the reset or Cancel to keep the current settings.
        </div>
    }

    <form asp-action="Edit" method="post" id="templateForm">
        <input type="hidden" asp-for="Id" />
        <partial name="_TemplateForm" model="Model" />
        <partial name="_PreviewPanel" model="Model" />

        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="submit" class="btn btn-primary">
                Save
            </button>
            <button type="button" class="btn btn-outline-secondary text-nowrap" data-bs-toggle="offcanvas"
                    data-bs-target="#resultsViewPreview" aria-controls="resultsViewPreview">
                <span class="fas fa-eye"></span>
                Preview
            </button>
            <a asp-action="Index" asp-route-clubInitials="@Model.ClubInitials" class="btn btn-outline-primary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/seriesResultsTemplatePreview.js" asp-append-version="true"></script>
    <script>
        // Help popovers, opened by a tap on touch screens.
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (el) {
            new bootstrap.Popover(el);
        });
    </script>
    @if (Model.IsReset)
    {
        <script>
            // The reset notice goes once any setting is changed; choosing a preview series isn't one.
            (function () {
                var notice = document.getElementById('resetNotice');
                var form = document.getElementById('templateForm');
                if (!notice || !form) {
                    return;
                }
                function hideNotice(event) {
                    if (event.target.id === 'previewSeriesId') {
                        return;
                    }
                    notice.remove();
                    form.removeEventListener('input', hideNotice);
                    form.removeEventListener('change', hideNotice);
                }
                form.addEventListener('input', hideNotice);
                form.addEventListener('change', hideNotice);
            })();
        </script>
    }
}
