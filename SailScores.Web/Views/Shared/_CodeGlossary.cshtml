@using SailScores.Core.Model
@using SailScores.Web.Services

@model Series

@{
    var scoreCodesUsed = Model?.FlatResults?.ScoreCodesUsed;
    var appliedGroups = Model?.FlatResults?.AppliedScoreCodeGroupSummaries;
}

@if (Model != null
   && ((scoreCodesUsed?.Count ?? 0) > 0 || (appliedGroups?.Count ?? 0) > 0))
{
    <div class="container">
        Scored using @Model.FlatResults?.ScoringSystemName
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Description</th>
                    <th scope="col">Value</th>
                </tr>
            </thead>
            <tbody>

                @if (scoreCodesUsed != null)
                {
                    @foreach (var code in scoreCodesUsed.OrderBy(c => c.Key))
                    {
                        <tr>
                            <th scope="row">@code.Key</th>
                            <td>@code.Value.Description</td>
                            <td>@code.Value.Formula</td>
                        </tr>
                    }
                }
                @if (appliedGroups != null)
                {
                    foreach (var appliedGroup in appliedGroups.OrderBy(g => g.Description))
                    {
                        <tr>
                            <th scope="row">Limit</th>
                            <td colspan="2">@appliedGroup.Description</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

