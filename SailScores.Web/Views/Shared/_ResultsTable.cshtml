@using SailScores.Core.Model
@using SailScores.Core.FlatModel
@using SailScores.Api.Enumerations
@using Microsoft.Extensions.Localization
@using SailScores.Web.Resources
@using SailScores.Web.Services
@using SailScores.Web.Services.Interfaces
@using SailScores.Web.Extensions
@using System.Text

@inject ILocalizerService localizer
@inject IWeatherService weatherService

@model ResultsTableViewModel
@{
    bool NoCompetitors = false;
    var customFieldColumns = (Model?.CustomFieldColumns ?? new List<SeriesResultsTemplateCustomField>())
        .Where(c => c.Visibility != ColumnVisibility.Hidden)
        .OrderBy(c => c.DisplayOrder)
        .ThenBy(c => c.FieldDefinitionId)
        .ToList();
    // Calculator-specific columns after the total, with visibility from the scoring system.
    var scoringColumns = Model?.VisibleScoringColumns ?? new List<FlatResultColumn>();
    string HeaderOrDefault(string header, string defaultKey) =>
        string.IsNullOrWhiteSpace(header) ? localizer[defaultKey] : header;
    var repeatedColumn = Model?.RepeatedColumn ?? RepeatedCompetitorColumn.None;
    var repeatedHeader = repeatedColumn switch
    {
        RepeatedCompetitorColumn.CompetitorName => HeaderOrDefault(Model.CompetitorNameHeader, "Helm"),
        RepeatedCompetitorColumn.SailNumber => HeaderOrDefault(Model.SailNumberHeader, "Sail"),
        RepeatedCompetitorColumn.BoatName => HeaderOrDefault(Model.BoatNameHeader, "Boat"),
        RepeatedCompetitorColumn.AlternativeSailNumber => HeaderOrDefault(Model.AlternativeSailNumberHeader, "Alt Sail"),
        _ => null
    };
    var showRepeatedColumn = repeatedColumn != RepeatedCompetitorColumn.None;
}

@using System.Collections.Generic

@if (Model != null)
{
    if (Model.Results.IsPreliminary ?? false)
    {
        <div><strong><span class="text-warning">Results are preliminary.</span> Protests may be pending.</strong></div>
    }
    <div class="table-responsive-sm">
        <table class="table table-hover table-sm mb-1 " summary="Results for series">
            <thead>
                <tr>
                    <th scope="col">@localizer["Place"]</th>
                    @if (Model.ShowTrend && !Model.ShowTrendOnAllDevices)
                    {
                        <th scope="col" class="d-none d-sm-table-cell">@localizer["Change"]*</th>
                    }
                    @if (Model.ShowTrendOnAllDevices)
                    {
                        <th scope="col" class="d-table-cell">@localizer["Change"]*</th>
                    }
                    @if (Model.SailNumberVisibility != ColumnVisibility.Hidden)
                    {
                        <th scope="col" class="@Model.SailNumberVisibility.ToCssClass()">@HeaderOrDefault(Model.SailNumberHeader, "Sail")</th>
                    }
                    @if (Model.AlternativeSailNumberVisibility != ColumnVisibility.Hidden)
                    {
                        <th scope="col" class="@Model.AlternativeSailNumberVisibility.ToCssClass()">@HeaderOrDefault(Model.AlternativeSailNumberHeader, "Alt Sail")</th>
                    }
                    @if (Model.CompetitorNameVisibility != ColumnVisibility.Hidden)
                    {
                        <th scope="col" class="@Model.CompetitorNameVisibility.ToCssClass()">@HeaderOrDefault(Model.CompetitorNameHeader, "Helm")</th>
                    }
                    @if (Model.BoatNameVisibility != ColumnVisibility.Hidden)
                    {
                        <th scope="col" class="@Model.BoatNameVisibility.ToCssClass()">@HeaderOrDefault(Model.BoatNameHeader, "Boat")</th>
                    }
                    @if (Model.CompetitorClubVisibility != ColumnVisibility.Hidden)
                    {
                        <th scope="col" class="@Model.CompetitorClubVisibility.ToCssClass()">@HeaderOrDefault(Model.CompetitorClubHeader, "Club")</th>
                    }
                    @foreach (var customField in customFieldColumns)
                    {
                        var headerText = Model.CustomFieldDefinitions.TryGetValue(customField.FieldDefinitionId, out var definition)
                            ? (string.IsNullOrWhiteSpace(definition.DisplayHeader) ? definition.Name : definition.DisplayHeader)
                            : customField.FieldDefinitionId.ToString("D").Substring(0, 8);
                        <th scope="col" class="@customField.Visibility.ToCssClass()">@headerText</th>
                    }
                    <th scope="col" class="text-center">@HeaderOrDefault(Model.TotalHeader, Model.Results?.TotalHeader ?? "Total")</th>
                    @foreach (var scoringColumn in scoringColumns)
                    {
                        <th scope="col" class="text-center @scoringColumn.Visibility.ToCssClass()">@localizer[scoringColumn.Header]</th>
                    }
                    @{
                        var colCount = 0;
                        var needCompNameColumn = false;
                        DateTime? prevRaceDate = null;
                    }
                    @foreach (var race in Model.ShowRaceColumns
                        ? Model.Results?.Races ?? Enumerable.Empty<FlatRace>()
                        : Enumerable.Empty<FlatRace>())
                    {
                        ++colCount;
                        var raceColumnClass = Model.RaceColumnCssClass(colCount - 1);
                        if (!needCompNameColumn && showRepeatedColumn)
                        {
                            needCompNameColumn = colCount % 23 == 20 && (Model.Results.NumberOfSailedRaces - colCount) > 10;
                        }
                        if (needCompNameColumn && (race.Date != prevRaceDate || colCount % 23 == 4 ))
                        {
                            needCompNameColumn = false;
                            <th scope="col" class="@(Model.HasSeparatorBefore(colCount - 1) ? "results-separator" : null)">@repeatedHeader</th>
                        }
                        if (race.State == RaceState.Abandoned || race.State == RaceState.Scheduled)
                        {
                            <th class="text-center d-none d-sm-table-cell @raceColumnClass" scope="col">
                                @if (Model.IsExport)
                                {
                                    @localizer.GetShortName(race, Model.DefaultDateFormat)
                                }
                                else
                                {
                                    if(race.IsSeries ?? false)
                                    {
                                        <a href="~/@ViewContext.RouteData.Values["ClubInitials"]/@race.seriesUrlName">@localizer.GetShortName(race, Model.DefaultDateFormat)</a>
                                    } else {
                                    @Html.ActionLink(
                                                 @localizer.GetShortName(race, Model.DefaultDateFormat)
                                                 , "Details", "Race", new { id = race.Id })
                                    }
                                    @if (Model.ShowWeather)
                                    {
                                    <div class="weather">
                                        @if (race.WindDirectionDegrees.HasValue)
                                        {
                                            <span class="wi wi-wind from-@race.WindDirectionDegrees?.ToString("N0")-deg ss-wi" data-bs-toggle="tooltip" title="@race.WindDirectionDegrees?.ToString("N0")°"></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(race.WindSpeed))
                                        {<span data-bs-toggle="tooltip" title="@race.WindSpeedUnits">@race.WindSpeed</span>}
                                        @if (((race.WindDirectionDegrees.HasValue) || (!string.IsNullOrWhiteSpace(race.WindSpeed)))
                                                               && !string.IsNullOrWhiteSpace(race.WeatherIcon))
                                        {
                                            <br />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(race.WeatherIcon))
                                        {
                                            <span class="wi @weatherService.GetIconCharacter(race.WeatherIcon) ss-wi"></span>
                                        }
                                    </div>
                                    }
                                }
                            </th>
                        }
                        else
                        {
                            <th class="text-center @raceColumnClass" scope="col">
                                @if (Model.IsExport)
                                {
                    @localizer.GetShortName(race, Model.DefaultDateFormat)
                                }
                                else
                                {
                                    if (race.IsSeries ?? false)
                                    {
                                        <a href="~/@ViewContext.RouteData.Values["ClubInitials"]/@race.seriesUrlName">@localizer.GetShortName(race, Model.DefaultDateFormat)</a>
                                    }
                                    else
                                    {
                                        @Html.ActionLink(
                                        @localizer.GetShortName(race, Model.DefaultDateFormat)
                                        , "Details", "Race", new { id = race.Id })
                                    }
                                    <br />
                                    @if (Model.ShowWeather)
                                    {
                                    <div class="weather">
                                        @if (race.WindDirectionDegrees.HasValue)
                                        {
                                            <span class="wi wi-wind from-@race.WindDirectionDegrees?.ToString("N0")-deg ss-wi" data-bs-toggle="tooltip" title="@race.WindDirectionDegrees?.ToString("N0")°"></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(race.WindSpeed))
                                        {<span data-bs-toggle="tooltip" title="@race.WindSpeedUnits">@race.WindSpeed</span>}
                                        @if (!string.IsNullOrWhiteSpace(race.WeatherIcon))
                                        {
                                            <br /><span class="wi @weatherService.GetIconCharacter(race.WeatherIcon) ss-wi"></span>
                                        }
                                    </div>
                                    }
                                }
                            </th>
                        }
                        prevRaceDate = race.Date;
                    }
                    @if (Model.ShowRaceColumns && showRepeatedColumn && (Model.Results.NumberOfSailedRaces) > 4)
                    {
                        <th scope="col" class="d-table-cell @((Model.Results.NumberOfSailedRaces < 25)?"d-md-none":"")">
                            @repeatedHeader
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @{ var firstRow = true;
                    var compList = Model.Results?.Competitors;
                    if ((compList?.Count() ?? 0) == 0)
                    {
                        compList = new List<FlatCompetitor>{
                        new FlatCompetitor {
                            Name= localizer["No competitors"]}
                        };
                        NoCompetitors = true;
                    }
                }

                @foreach (var comp in compList)
                {
                    colCount = 0;
                    var compScore = Model.Results.GetScore(comp);
                    <tr>
                        <th scope="row">@compScore?.Rank</th>
                    @if (Model.ShowTrend && !Model.ShowTrendOnAllDevices)
                    {
                        <th scope="row" class="d-none d-sm-table-cell">
                            @if (compScore?.Trend > 0)
                            {
                            <span class="text-success">
                                <span class="fas fa-arrow-up"></span>
                                    @compScore.Trend.Value
                            </span>
                            }
                            else if (compScore?.Trend < 0)
                            {
                                <span class="text-danger">
                                    <span class="fas fa-arrow-down"></span>
                                        @Math.Abs(compScore.Trend.Value)
                                </span>
                            }
                        </th>
                    }
                    @if (Model.ShowTrendOnAllDevices)
                    {
                        <th scope="row" class="d-table-cell">
                            @if (compScore?.Trend > 0)
                            {
                                <span class="text-success">
                                    <span class="fas fa-arrow-up"></span>
                                        @compScore.Trend.Value
                                </span>
                            }
                            else if (compScore?.Trend < 0)
                            {
                                <span class="text-danger">
                                    <span class="fas fa-arrow-down"></span>
                                        @Math.Abs(compScore.Trend.Value)
                                </span>
                            }
                        </th>   
                    }
                    @if (Model.SailNumberVisibility != ColumnVisibility.Hidden)
                    {
                        <th scope="row" class="@Model.SailNumberVisibility.ToCssClass()">@Model.GetSailNumber(comp)</th>
                    }
                    @if (Model.AlternativeSailNumberVisibility != ColumnVisibility.Hidden)
                    {
                        <td class="@Model.AlternativeSailNumberVisibility.ToCssClass()">@comp.AlternativeSailNumber</td>
                    }
                    @if (Model.CompetitorNameVisibility != ColumnVisibility.Hidden)
                    {
                        <th scope="row" class="@Model.CompetitorNameVisibility.ToCssClass()">
                            @if (Model.IsExport || Model.ExcludeCompetitorLinks || NoCompetitors)
                            {
                                @comp.Name
                            }
                            else
                            {
                                <a asp-route="Competitor"
                                   asp-route-urlName="@(comp.UrlName)"
                                   asp-route-clubInitials="@ViewContext.RouteData.Values["ClubInitials"]">@comp.Name</a>
                            }
                        </th>
                    }
                    @if (Model.BoatNameVisibility != ColumnVisibility.Hidden)
                    {
                        <td class="@Model.BoatNameVisibility.ToCssClass()">@comp.BoatName</td>
                    }
                    @if (Model.CompetitorClubVisibility != ColumnVisibility.Hidden)
                    {
                        <td class="@Model.CompetitorClubVisibility.ToCssClass()">@comp.HomeClubName</td>
                    }
                    @foreach (var customField in customFieldColumns)
                    {
                        var value = comp.CustomFieldValues != null && comp.CustomFieldValues.TryGetValue(customField.FieldDefinitionId, out var fieldValue)
                            ? fieldValue
                            : null;
                        <td class="@customField.Visibility.ToCssClass()">@value</td>
                    }
                    <td scope="row" class="text-center">
                        <strong>
                            @if (Model.Results.IsPercentSystem)
                            {
                                var tooltipText = new StringBuilder();
                                if (compScore?.TotalScore != compScore?.Average && (compScore?.Average.HasValue ?? false))
                                {
                                    tooltipText.Append(String.Format("{0:0.###}", compScore?.Average) + "&#010;");
                                }
                                if ((compScore?.Average.HasValue ?? false) || (compScore?.TotalScore.HasValue ?? false))
                                {
                                    tooltipText.Append(compScore?.PointsEarned + " / " + compScore?.PointsPossible);
                                }
                                if (tooltipText.Length > 0 && (compScore?.ParticipationPercent.HasValue ?? false))
                                {
                                    tooltipText.Append("&#010;");
                                }
                                if (compScore?.ParticipationPercent.HasValue ?? false)
                                {
                                        tooltipText.Append("Participation: " + @String.Format("{0:0.#}%", compScore?.ParticipationPercent));
                                }
                                <span data-bs-toggle="tooltip" data-bs-trigger="manual focus hover"
                                  tabindex="0" title="@Html.Raw(tooltipText.ToString())">
                                        @if(compScore?.TotalScore != null)
                                        {
                                            @(String.Format("{0:0.###}", compScore.TotalScore))
                                        }
                                        else if (Model.Results.UnrankedShowsPoints && compScore?.PointsEarned != null)
                                        {
                                          <span class="text-muted">@(String.Format("{0:0.###}", compScore.PointsEarned))</span>
                                        }
                                        else if (compScore?.Average != null)
                                        {
                                          <span class="text-muted">@(String.Format("{0:0.###}", compScore.Average))</span>
                                        } else {
                                            @Html.Raw("&mdash;")
                                        }
</span>
                            } else {
                                    @String.Format("{0:0.###}", compScore?.TotalScore)
                            }
                        </strong>
                    </td>
                    @foreach (var scoringColumn in scoringColumns)
                    {
                        <td class="text-center @scoringColumn.Visibility.ToCssClass()">@scoringColumn.GetDisplayText(compScore)</td>
                    }
                    @{
                        colCount = 0;
                        needCompNameColumn = false;
                        prevRaceDate = null;
                    }
                        @foreach (var race in Model.ShowRaceColumns ? Model.Results.Races : Enumerable.Empty<FlatRace>())
                    {
                        ++colCount;
                        var raceColumnClass = Model.RaceColumnCssClass(colCount - 1);
                        if (!needCompNameColumn && showRepeatedColumn)
                        {
                                needCompNameColumn = colCount % 23 == 20 && (Model.Results.NumberOfSailedRaces - colCount) > 10;
                        }
                        if (needCompNameColumn && (race.Date != prevRaceDate || colCount % 23 == 4))
                        {
                            needCompNameColumn = false;
                            <td class="@(Model.HasSeparatorBefore(colCount - 1) ? "results-separator" : null)">@Model.GetRepeatedValue(comp)</td>

                        }
                        if (race.State == RaceState.Abandoned)
                        {
                            if (firstRow)
                            {
                                    <td rowspan="@(Model.Results?.Competitors?.Count() ?? 1)" class="abandoned d-none d-sm-table-cell @raceColumnClass">
                                    <span>@localizer["Abandoned"].ToUpper()</span>
                                </td>
                            }
                        }
                        else if (race.State == RaceState.Scheduled)
                        {
                            if (firstRow)
                            {
                                    <td rowspan="@(Model.Results?.Competitors?.Count() ?? 1)" class="scheduled d-none d-sm-table-cell @raceColumnClass">
                                        <span>@localizer["Scheduled"].ToUpper()</span>
                                </td>
                            }
                        }
                        else
                        {
                            var result = Model.Results.GetScore(comp, race);

                            @await Html.PartialAsync("_ScoreCell", new ScoreCellViewModel
                               {
                                   Result = result,
                                    IsPercentSystem = Model.Results.IsPercentSystem,
                                    LowerScoreWins = Model.Results.LowerScoreWins ?? false,
                                    ScoreCodesUsed = Model.Results.ScoreCodesUsed,
                                    HighlightTopThree = Model.HighlightTopThree,
                                    CssClass = raceColumnClass,
                                    DiscardStrikethrough = Model.DiscardStrikethrough,
                                    DiscardCssClass = Model.DiscardCssClass,
                                    DiscardParentheses = Model.DiscardParentheses,
                                    CodeDisplay = Model.GetScoreCodeDisplay(result?.Code)
                               })
                        }
                        prevRaceDate = race.Date;
                    }
                    @if (Model.ShowRaceColumns && showRepeatedColumn && (Model.Results.NumberOfSailedRaces) > 4)
                    {
                        <th class="d-table-cell @(( Model.Results.NumberOfSailedRaces < 25)?"d-md-none":"")"
                        scope="row">@Model.GetRepeatedValue(comp)</th>
                    }
                    @{
                        firstRow = false;
                    }
                </tr>
                        }
            </tbody>
        </table>
        <div class="row">
            <div class="col-md-9">
                @if (Model.ShowTrend && !Model.ShowTrendOnAllDevices)
                {
                    <span class="d-none d-sm-inline">
                        * @Model.TrendLegend
                    </span>
                }
                @if (Model.ShowTrendOnAllDevices)
                {
                    <span>
                        * @Model.TrendLegend
                    </span>
                }
            @if (Model.UpdatedDate.HasValue)
            {
                <span class="small fst-italic">
                    @localizer["Updated"] @(Model.UpdatedDate.Value.ToString("f")) UTC
                    @if (!String.IsNullOrWhiteSpace(Model.Results.UpdatedBy))
                    {
                        @:by @Model.Results.UpdatedBy
                    }
                </span>
            }
            </div>
            <div class="col-md-3 text-end">
                @if (Model.ShowExportButtons)
                {
                    <a class="btn btn-outline-secondary btn-sm"
                       asp-action="ExportHtml"
                       asp-controller="Series"
                       asp-route-id="@Model.SeriesId"
                       title="Export as HTML">
                        <span class="fas fa-2x fa-file-code"></span>
                    </a>
                    <a class="btn btn-outline-secondary btn-sm"
                       asp-action="ExportCsv"
                       asp-controller="Series"
                       asp-route-id="@Model.SeriesId"
                       title="Export as CSV">
                        <span class="fas fa-2x fa-file-csv"></span>
                    </a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div></div>
}
