@model IList<SailScores.Core.Model.CompetitorFieldDefinition>

@{
    ViewData["Title"] = "Custom Fields";
    Layout = "~/Views/Shared/_ClubLayout.cshtml";
}

<h2>Custom Fields</h2>
<p class="text-muted">Define the custom competitor fields available for your club.</p>

<a asp-action="Create" asp-route-clubInitials="@ViewData["ClubInitials"]" class="btn btn-primary mb-3">Add Field</a>

@if (Model != null && Model.Any())
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Field name</th>
                <th>Display label</th>
                <th>Value type</th>
                <th>Display order</th>
                <th>Active?</th>
                <th>Highly visible</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var field in Model)
            {
                <tr>
                     <td>
                        <a asp-action="Edit" asp-route-clubInitials="@ViewData["ClubInitials"]" asp-route-id="@field.Id" class="btn btn-sm btn-outline-primary me-2" title="Edit">
                            <span class="fas fa-pen"></span>
                        </a>
                        @if (field.IsActive)
                        {
                            <form asp-action="Inactivate" method="post" style="display:inline;" onsubmit="return confirm('Mark this field as inactive?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="clubInitials" value="@ViewData["ClubInitials"]" />
                                <input type="hidden" name="id" value="@field.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Inactivate">
                                    <span class="fas fa-eye-slash"></span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Reactivate" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="clubInitials" value="@ViewData["ClubInitials"]" />
                                <input type="hidden" name="id" value="@field.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivate">
                                    <span class="fas fa-undo"></span>
                                </button>
                            </form>
                        }
                        <form asp-action="DeletePermanent" method="post" style="display:inline;" onsubmit="return confirm('Permanently delete this field and all values? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clubInitials" value="@ViewData["ClubInitials"]" />
                            <input type="hidden" name="id" value="@field.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete permanently">
                                <span class="fas fa-trash"></span>
                            </button>
                        </form>
                    </td>
                    <td>@field.Name</td>
                    <td>@field.DisplayHeader</td>
                    <td>@field.DataType</td>
                    <td>@field.DisplayOrder</td>
                    <td>@(field.IsActive ? "Yes" : "No")</td>
                    <td>@(field.HighlyVisible == true ? "Yes" : "No")</td>

                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No custom fields are defined yet.</p>
}
